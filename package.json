{
  "name": "seo-review-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "eleventy --serve",
    "build": "eleventy",
    "check:locales": "node scripts/check-locales.mjs",
    "check:games": "node scripts/check-games.mjs",
    "check:provenance": "node scripts/check-provenance.mjs",
    "test:stage412": "node scripts/test-stage412.mjs",
    "check:production": "node scripts/check-production.mjs",
    "test:stage42": "node scripts/test-stage42.mjs",
    "check:seo": "node scripts/check-stage42.mjs",
    "audit:editorial": "node scripts/editorial43.mjs",
    "check:editorial": "node scripts/editorial43.mjs --strict",
    "test:stage43": "node scripts/test-stage43.mjs && node scripts/test-stage43-log.mjs",
    "queue:editorial": "node scripts/run-stage431.mjs",
    "test:stage431": "node scripts/test-stage431.mjs",
    "test:stage432": "node scripts/test-stage432.mjs",
    "check:display": "node scripts/check-stage432.mjs",
    "test:stage433": "node scripts/test-stage433.mjs",
    "test:stage44": "node scripts/test-stage44.mjs",
    "check:navigation": "node scripts/check-stage44.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0"
  }
}
