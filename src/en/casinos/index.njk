---
layout: layouts/base.njk
lang: en
permalink: /en/casinos/

metaTitle: Casino Listings | Verification Pending
metaDescription: Browse casino listings awaiting verified operator claims and editorial decisions.

canonical: /en/casinos/

breadcrumbs:
  - label: Home
    url: /en/
  - label: Casinos
---

<section class="page-hero">
  <div class="container">
    {% include "components/breadcrumbs/breadcrumbs.njk" %}

    <h1>Online Casinos</h1>

    <p>
      Browse casino names while claims about licences, offers, withdrawals and ratings undergo editorial verification.
    </p>
  </div>
</section>

<section class="casinos-search" data-casinos-search>
  <div class="container">
    <div class="casinos-search__panel">
      <div class="casinos-search__field">
        <label class="casinos-search__label" for="casinos-search">
          Search casinos
        </label>

        <span class="casinos-search__icon" aria-hidden="true">⌕</span>

        <input
          id="casinos-search"
          aria-controls="casinos-results"
          class="casinos-search__input"
          type="search"
          placeholder="Search casino..."
          autocomplete="off"
          data-casinos-search-input
        >
      </div>

      <div class="casinos-search__field">
        <label class="casinos-search__label" for="casino-type-filter">
          Type
        </label>

        <select class="casinos-search__select" id="casino-type-filter" data-casino-type-filter
          {% if not casinoCatalog442.types.length %}disabled aria-describedby="casino-type-note"{% endif %}>
          <option value="">All types</option>
          {% for item in casinoCatalog442.types %}
            <option value="{{ item.value }}">{{ item.label }}</option>
          {% endfor %}
        </select>
        {% if not casinoCatalog442.types.length %}
          <p class="casinos-search__note" id="casino-type-note">Type filtering becomes available when individual values are reviewed.</p>
        {% endif %}
      </div>

      <div class="casinos-search__field">
        <label class="casinos-search__label" for="casino-withdrawal-filter">
          Withdrawal
        </label>

        <select class="casinos-search__select" id="casino-withdrawal-filter" data-casino-withdrawal-filter
          disabled aria-describedby="casino-withdrawal-note">
          <option value="">All speeds</option>
        </select>
        <p class="casinos-search__note" id="casino-withdrawal-note">Withdrawal claims are not approved for filtering.</p>
      </div>

      <div class="casinos-search__field">
        <label class="casinos-search__label" for="casino-sort-filter">
          Sort by
        </label>

        <select class="casinos-search__select" id="casino-sort-filter" data-casino-sort-filter>
          <option value="title-asc">Title A-Z</option>
        </select>
      </div>

      <div class="casinos-search__actions">
        <button class="casinos-search__button casinos-search__button--secondary" data-reset-casino-filters type="button">
          Reset
        </button>

        <p class="casinos-search__count" role="status" aria-live="polite" aria-atomic="true" data-casinos-count>{{ casinos.length }} casino{% if casinos.length != 1 %}s{% endif %} found</p>
      </div>
    </div>

    <p class="casinos-search__empty" data-casinos-empty role="status">
      No casinos found. Try another search or reset filters.
    </p>

    <div class="casinos-search__grid" id="casinos-results" data-casinos-grid>
      {% for casino in casinos %}
        {% include "components/casino-card/casino-card.njk" %}
      {% endfor %}
    </div>
  </div>
</section>

<script src="/assets/js/pages/catalog-search442.js" defer></script>
<script src="/assets/js/pages/casinos-search.js" defer></script>