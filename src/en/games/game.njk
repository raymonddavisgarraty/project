---
layout: layouts/base.njk
pagination:
  data: games
  size: 1
  alias: game
permalink: "/en/games/{{ game.slug }}/index.html"
eleventyComputed:
  lang: en
  metaTitle: "{{ game.hero.title }} | Editorial verification pending"
  metaDescription: "Game information is undergoing editorial fact verification. Numerical characteristics and ratings are withheld until reviewed."
  canonical: "/en/games/{{ game.slug }}/"
  breadcrumbs:
    - label: Home
      url: /en/
    - label: Games
      url: /en/games/
    - label: "{{ game.hero.title }}"
---
{% if editorialDisplay432.game(game) %}
{% include "components/game-hero/game-hero.njk" %}

<section class="section">
  <div class="container detail-layout">
    <article class="detail-content">
      {% set toc = [] %}
      {% if game.sections.overview and game.sections.overview.text %}
        {% set toc = toc.concat([{ id: "overview", label: "Overview" }]) %}
      {% endif %}
      {% set toc = toc.concat([{ id: "game-info", label: "Game information" }]) %}
      {% if game.rating and game.rating.gameplay is defined %}
        {% set toc = toc.concat([{ id: "rating-breakdown", label: "Rating breakdown" }]) %}
      {% endif %}
      {% if game.sections.features and game.sections.features.items and game.sections.features.items.length %}
        {% set toc = toc.concat([{ id: "features", label: "Features" }]) %}
      {% endif %}
      {% if game.sections.gameplay and game.sections.gameplay.text %}
        {% set toc = toc.concat([{ id: "gameplay", label: "Gameplay" }]) %}
      {% endif %}
      {% if game.sections.rtpVolatility and game.sections.rtpVolatility.text %}
        {% set toc = toc.concat([{ id: "rtp-volatility", label: "RTP & volatility" }]) %}
      {% endif %}
      {% if game.sections.bonusFeatures and game.sections.bonusFeatures.text %}
        {% set toc = toc.concat([{ id: "bonus-features", label: "Bonus features" }]) %}
      {% endif %}
      {% if game.sections.howToPlay and game.sections.howToPlay.items and game.sections.howToPlay.items.length %}
        {% set toc = toc.concat([{ id: "how-to-play", label: "How to play" }]) %}
      {% endif %}
      {% if game.sections.mobileExperience and game.sections.mobileExperience.text %}
        {% set toc = toc.concat([{ id: "mobile-experience", label: "Mobile experience" }]) %}
      {% endif %}
      {% if game.faq and game.faq.length %}
        {% set toc = toc.concat([{ id: "faq-title", label: "FAQ" }]) %}
      {% endif %}
      {% set tocClass = "toc--content" %}
      {% include "components/table-of-contents/table-of-contents.njk" %}

      {% if game.sections.overview and game.sections.overview.text %}
      <h2 id="overview">{{ game.sections.overview.title }}</h2>
      <p>{{ game.sections.overview.text }}</p>
      {% endif %}

      <h2 id="game-info">Game information</h2>

      {% set rows = [
        { label: "Provider", value: game.facts.provider },
        { label: "Rating", value: game.rating.overall + " / 5" },
        { label: "RTP", value: game.facts.rtp },
        { label: "Volatility", value: game.facts.volatility },
        { label: "Reels", value: game.facts.reels },
        { label: "Paylines", value: game.facts.paylines },
        { label: "Release year", value: game.facts.releaseYear },
        { label: "Last updated", value: game.updatedDate }
      ] %}

      {% include "components/info-table/info-table.njk" %}

      {% if game.rating and game.rating.gameplay is defined %}
        {% set ratings = [
          { label: "Gameplay", value: game.rating.gameplay },
          { label: "Bonus features", value: game.rating.bonusFeatures },
          { label: "Mobile experience", value: game.rating.mobile },
          { label: "Design", value: game.rating.design }
        ] %}
        {% include "components/rating-breakdown/rating-breakdown.njk" %}
      {% endif %}

      {% if game.sections.features and game.sections.features.items and game.sections.features.items.length %}
        <h2 id="features">{{ game.sections.features.title }}</h2>
        <ul>
          {% for item in game.sections.features.items %}
            <li>{{ item }}</li>
          {% endfor %}
        </ul>
      {% endif %}

      {% if game.sections.gameplay and game.sections.gameplay.text %}
        <h2 id="gameplay">{{ game.sections.gameplay.title }}</h2>
        <p>{{ game.sections.gameplay.text }}</p>
      {% endif %}

      {% if game.sections.rtpVolatility and game.sections.rtpVolatility.text %}
        <h2 id="rtp-volatility">{{ game.sections.rtpVolatility.title }}</h2>
        <p>{{ game.sections.rtpVolatility.text }}</p>
      {% endif %}

      {% if game.sections.bonusFeatures and game.sections.bonusFeatures.text %}
        <h2 id="bonus-features">{{ game.sections.bonusFeatures.title }}</h2>
        <p>{{ game.sections.bonusFeatures.text }}</p>
      {% endif %}

      {% if game.sections.howToPlay and game.sections.howToPlay.items and game.sections.howToPlay.items.length %}
        <h2 id="how-to-play">{{ game.sections.howToPlay.title }}</h2>
        <ol>
          {% for item in game.sections.howToPlay.items %}
            <li>{{ item }}</li>
          {% endfor %}
        </ol>
      {% endif %}

      {% if game.sections.mobileExperience and game.sections.mobileExperience.text %}
        <h2 id="mobile-experience">{{ game.sections.mobileExperience.title }}</h2>
        <p>{{ game.sections.mobileExperience.text }}</p>
      {% endif %}

      {% set faq = game.faq %}
      {% include "components/faq/faq.njk" %}
    </article>

    <div class="detail-sidebar">
      {% set affiliateId = game.monetization.affiliateId %}
      {% set rating = game.rating.overall %}
      {% include "components/cta-panel/cta-panel.njk" %}
      {% set tocClass = "toc--sidebar" %}
      {% include "components/table-of-contents/table-of-contents.njk" %}

      {% set pros = game.pros %}
      {% set cons = game.cons %}
      {% include "components/pros-cons/pros-cons.njk" %}
    </div>
  </div>
</section>
{% else %}
<section class="page-hero" aria-label="Editorial verification notice">
  <div class="container">
    {% include "components/breadcrumbs/breadcrumbs.njk" %}
    <h1>{{ game.hero.title }}</h1>
    <p><strong>Editorial verification pending.</strong> This game listing has not completed its source and editorial checks. Unreviewed facts, numerical ratings, promotions and descriptive claims are intentionally withheld.</p>
    <p><a href="/en/games/">Browse games catalogue</a></p>
  </div>
</section>
{% endif %}
