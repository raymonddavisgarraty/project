---
layout: layouts/base.njk
lang: en
pagination:
  data: games
  size: 12
  alias: pageGames
permalink: "/en/games/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber + 1 }}/{% endif %}index.html"
eleventyComputed:
  canonical: "/en/games/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber + 1 }}/{% endif %}"

metaTitle: Game Listings | Verification Pending
metaDescription: Browse game listings undergoing independent source and editorial verification.


breadcrumbs:
  - label: Home
    url: /en/
  - label: Games
---

<section class="page-hero">
  <div class="container">
    {% include "components/breadcrumbs/breadcrumbs.njk" %}

    <span class="rh-catalogue-eyebrow">01 · Game library</span>
    <h1>Slot Games</h1>

    <p>
      Browse game pages by title. Unreviewed provider details, game statistics and ratings are withheld.
    </p>
  </div>
</section>

<section class="games-search" data-games-search>
  <div class="container">
    <noscript>
      <p class="catalog-nojs-notice">Search and filters require JavaScript. All games listings remain available below.</p>
    </noscript>
    <div class="games-search__panel">
      <div class="games-search__field games-search__field--wide">
        <label class="games-search__label" for="games-search">
          Search games
        </label>

        <span class="games-search__icon" aria-hidden="true">⌕</span>

        <input
          id="games-search"
          aria-controls="games-results"
          class="games-search__input"
          type="search"
          placeholder="Search by game title..."
          autocomplete="off"
          data-games-search-input
        >
      </div>

      <div class="games-search__field">
        <label class="games-search__label" for="provider-filter">
          Provider
        </label>

        <select class="games-search__select" id="provider-filter" data-provider-filter
          {% if not gameCatalog44.providers.length %}disabled aria-describedby="provider-filter-note"{% endif %}>
          <option value="">All providers</option>
          {% for provider in gameCatalog44.providers %}
            <option value="{{ provider.value }}">{{ provider.label }}</option>
          {% endfor %}
        </select>
        {% if not gameCatalog44.providers.length %}
          <p class="games-search__note" id="provider-filter-note">Provider filters become available when source-reviewed values exist.</p>
        {% endif %}
      </div>

      <div class="games-search__field">
        <label class="games-search__label" for="volatility-filter">
          Volatility
        </label>

        <select class="games-search__select" id="volatility-filter" data-volatility-filter
          {% if not gameCatalog44.volatilities.length %}disabled aria-describedby="volatility-filter-note"{% endif %}>
          <option value="">All volatility</option>
          {% for volatility in gameCatalog44.volatilities %}
            <option value="{{ volatility.value }}">{{ volatility.label }}</option>
          {% endfor %}
        </select>
        {% if not gameCatalog44.volatilities.length %}
          <p class="games-search__note" id="volatility-filter-note">Volatility filters become available after independent field review.</p>
        {% endif %}
      </div>

      <div class="games-search__field">
        <label class="games-search__label" for="sort-filter">
          Sort by
        </label>

        <select class="games-search__select" id="sort-filter" data-sort-filter>
          <option value="title-asc">Title A-Z</option>
          {# Rating and RTP sorting require approved data. #}
        </select>
      </div>

      <div class="games-search__actions">
        <button class="games-search__button" data-random-game type="button">
          Highlight a random game
        </button>

        <button class="games-search__button games-search__button--secondary" data-reset-filters type="button">
          Reset
        </button>

        <p class="games-search__count" role="status" aria-live="polite" aria-atomic="true" data-games-count>{{ games.length }} game{% if games.length != 1 %}s{% endif %} found</p>
      </div>
    </div>

    <p class="games-search__empty" data-games-empty role="status">
      No games found. Try another search or reset filters.
    </p>

    <div class="games-search__grid" id="games-results" data-games-grid>
      {% for game in pageGames %}
        {% include "components/game-grid-card/game-grid-card.njk" %}
      {% endfor %}
    </div>
    {% if pagination.hrefs.length > 1 %}
    <nav class="rh-pagination" aria-label="Game catalogue pages" data-catalogue-pagination>
      {% if pagination.href.previous %}
        <a class="rh-pagination__link" href="{{ pagination.href.previous }}" rel="prev">← Previous</a>
      {% endif %}
      {% for href in pagination.hrefs %}
        {% if loop.index0 == 0 or loop.index0 == pagination.pageNumber or loop.index0 == pagination.pageNumber - 1 or loop.index0 == pagination.pageNumber + 1 or loop.last %}
          <a class="rh-pagination__link{% if loop.index0 == pagination.pageNumber %} rh-pagination__link--current{% endif %}" href="{{ href }}"{% if loop.index0 == pagination.pageNumber %} aria-current="page"{% endif %}>{{ loop.index }}</a>
        {% endif %}
      {% endfor %}
      {% if pagination.href.next %}
        <a class="rh-pagination__link rh-pagination__next" href="{{ pagination.href.next }}" rel="next">More games →</a>
      {% endif %}
    </nav>
    {% endif %}
  </div>
</section>

<script src="/assets/js/pages/catalog-search442.js" defer></script>
<script src="/assets/js/pages/games-search.js" defer></script>