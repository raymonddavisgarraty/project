<!doctype html>
<html lang="{{ lang or site.defaultLanguage }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>{{ metaTitle }}</title>
  <meta name="description" content="{{ metaDescription }}">
  {# Only an independently approved, revision-bound release may be indexed.
     Generated preview pages remain useful for QA but always noindex. #}
  {% set effectiveRobots = "noindex, follow" %}
  {% if indexability42.allows(canonical) %}
    {% set effectiveRobots = robots or "index, follow" %}
  {% endif %}
  <meta name="robots" content="{{ effectiveRobots }}">

  <link rel="canonical" href="{{ canonical | absoluteUrl(site.url) }}">
  {# Only render alternate URLs explicitly supplied for published translations. #}
  {% if alternatePages %}
    {% for alternate in alternatePages %}
      {% if alternate.published and alternate.lang and alternate.url %}
  <link rel="alternate" hreflang="{{ alternate.lang }}" href="{{ alternate.url | absoluteUrl(site.url) }}">
      {% endif %}
    {% endfor %}
  {% endif %}

  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:title" content="{{ metaTitle }}">
  <meta property="og:description" content="{{ metaDescription }}">
  <meta property="og:url" content="{{ canonical | absoluteUrl(site.url) }}">
  <meta property="og:site_name" content="{{ site.name }}">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ metaTitle }}">
  <meta name="twitter:description" content="{{ metaDescription }}">

  <link rel="stylesheet" href="/assets/css/main.css">

  {% if jsonLd %}
    {% if jsonLd['@type'] == 'WebSite' %}
      {% set resolvedJsonLd = {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: site.name,
        url: canonical | absoluteUrl(site.url),
        inLanguage: lang or site.defaultLanguage
      } %}
      <script type="application/ld+json">{{ resolvedJsonLd | dump | safe }}</script>
    {% else %}
      <script type="application/ld+json">{{ jsonLd | dump | safe }}</script>
    {% endif %}
  {% endif %}
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>

  {% include "components/site-header/site-header.njk" %}

  <main id="main-content">
    {{ content | safe }}
  </main>

  {% include "components/site-footer/site-footer.njk" %}
</body>
</html>