<section class="game-hero">
  <div class="container">
    {% include "components/breadcrumbs/breadcrumbs.njk" %}

    <div class="game-hero__card">
      <div class="game-hero__content">
        <p class="game-hero__eyebrow">Original game information</p>

        <h1 class="game-hero__title">{{ game.seo.h1 }}</h1>

        <p class="game-hero__text">{{ game.hero.description }}</p>
        {# Theme markers come only from this game's approved editorial module. #}
        {% if game.featureTags and game.featureTags.length %}
          {% set items = game.featureTags %}
        {% else %}
          {% set items = [{ symbol: "🎮", label: "Game guide" }, { symbol: "📖", label: "Features explained" }] %}
        {% endif %}
        {% set pillClass = "pill-list--inline" %}
        {% set pillLabel = "Game theme and review sections" %}
        {% include "components/pill-list/pill-list.njk" %}

        {% if game.rating and game.rating.overall is defined %}
        <div class="game-hero__rating" aria-label="Rating {{ game.rating.overall }} out of 5">
          {% set name = "star" %}
          {% include "components/icon/icon.njk" %}
          <strong>{{ game.rating.overall }} / 5</strong>
          <span>Editorial rating</span>
        </div>
        {% endif %}

        <div class="game-hero__actions">
          {% set offer = commercial.forGame(game) %}
          {% if offer %}
            {% if offer.playUrl %}
              <a class="ui-button ui-button--success" href="{{ offer.playUrl }}" rel="nofollow sponsored noopener" target="_blank">Play now</a>
            {% endif %}
            {% if offer.demoUrl %}
              <a class="ui-button ui-button--outline" href="{{ offer.demoUrl }}" rel="nofollow noopener" target="_blank">Play demo</a>
            {% endif %}
          {% endif %}

          <a class="ui-button ui-button--ghost" href="#game-info">
            Read review
          </a>
        </div>
      </div>

      <div class="game-hero__media">
        {% set cover = game.media.cover %}
        {% set title = game.hero.title %}
        {% include "components/media-cover/media-cover.njk" %}
      </div>
    </div>
    {% set facts = visualFactsV3.game(editorialFields433.gameRows(game)) %}
    {% set factsLabel = "Game at a glance" %}
    {% include "components/quick-facts/quick-facts.njk" %}
  </div>
</section>