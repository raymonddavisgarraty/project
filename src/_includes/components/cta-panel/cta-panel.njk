<aside class="cta-panel ui-card" aria-label="Review actions">
  <div class="cta-panel__rating">
    <span class="cta-panel__rating-label">Rating</span>
    <strong class="cta-panel__rating-value">★ {{ rating }} / 5</strong>
  </div>

  {% if game %}
    {% set offer = commercial.forGame(game) %}
  {% elif casino %}
    {% set offer = commercial.forCasino(casino) %}
  {% else %}
    {% set offer = null %}
  {% endif %}

  {% if offer %}
    {% if offer.playUrl %}
      <a class="ui-button ui-button--success" href="{{ offer.playUrl }}" rel="nofollow sponsored noopener" target="_blank">Try now</a>
    {% endif %}
    {% if offer.demoUrl %}
      <a class="ui-button ui-button--secondary" href="{{ offer.demoUrl }}" rel="nofollow noopener" target="_blank">Play demo</a>
    {% endif %}
    {% if offer.bonusUrl %}
      <a class="ui-button ui-button--secondary" href="{{ offer.bonusUrl }}" rel="nofollow sponsored noopener" target="_blank">Get bonus</a>
    {% endif %}
  {% endif %}

  {% if site.social.telegram %}
    <a class="ui-button ui-button--outline" href="{{ site.social.telegram }}" rel="noopener" target="_blank">Join Telegram channel</a>
  {% endif %}
</aside>
