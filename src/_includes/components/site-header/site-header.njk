<header class="site-header" data-site-header>
  <div class="container site-header__inner">
    <a class="site-header__logo" href="/en/">
      <span class="site-header__logo-mark" aria-hidden="true">R</span>
      <span>{{ site.name }}</span>
    </a>
    <button class="site-header__toggle" type="button" aria-expanded="false"
      aria-controls="site-menu" data-menu-toggle>Menu</button>
    <nav class="site-header__nav" id="site-menu" aria-label="Main navigation" data-site-menu>
      <ul class="site-header__list">
        <li><a class="site-header__link" href="/en/">Home</a></li>
        <li><a class="site-header__link" href="/en/games/">Games</a></li>
        <li><a class="site-header__link" href="/en/casinos/">Casinos</a></li>
      </ul>
      <div class="site-header__tools">
        <a class="site-header__search" href="/en/games/">⌕ Search</a>
        <span class="site-header__language" aria-label="Current language: English">EN</span>
        <label class="switch" aria-label="Toggle light and dark theme">
          <input class="switch__input" type="checkbox" role="switch" data-theme-toggle>
          <span class="switch__label" aria-hidden="true">☼ Theme</span>
        </label>
      </div>
    </nav>
  </div>
</header>
<script src="/assets/js/components/site-header.js" defer></script>
<script src="/assets/js/components/theme-toggle.js" defer></script>
