<header class="site-header" data-site-header>
  <div class="container site-header__inner">
    <a class="site-header__logo" href="/en/" aria-label="{{ site.name }} home">
      <span class="site-header__logo-mark">R</span>
      <span>{{ site.name }}</span>
    </a>

    <button
      class="site-header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
      data-menu-toggle
    >
      Menu
    </button>

    <nav class="site-header__nav" id="site-menu" aria-label="Main navigation" data-site-menu>
      <ul class="site-header__list">
        <li>
          <a class="site-header__link" href="/en/">Home</a>
        </li>

        <li class="site-header__item">
          <button class="site-header__link site-header__dropdown-toggle" type="button" aria-expanded="false" data-dropdown-toggle>
            Games
          </button>

          <div class="site-header__dropdown">
  <a href="/en/games/">All games</a>
  <a href="/en/games/?sort=rating-desc">Popular slots</a>
  <a href="/en/games/?sort=rtp-desc">High RTP slots</a>
  <a href="/en/games/?volatility=high">High volatility</a>
  <a href="/en/games/?provider=pragmatic%20play">Pragmatic Play</a>
</div>
        </li>

        <li class="site-header__item">
          <button class="site-header__link site-header__dropdown-toggle" type="button" aria-expanded="false" data-dropdown-toggle>
            Casinos
          </button>

          <div class="site-header__dropdown">
            <a href="/en/casinos/">All casinos</a>
            <a href="/en/casinos/">New casinos</a>
            <a href="/en/casinos/">Crypto casinos</a>
            <a href="/en/casinos/">Fast withdrawal</a>
          </div>
        </li>

        <li>
          <a class="site-header__link" href="/en/providers/">Providers</a>
        </li>

        <li>
          <a class="site-header__link" href="/en/bonuses/">Bonuses</a>
        </li>

        <li>
          <a class="site-header__link" href="/en/articles/">Articles</a>
        </li>
      </ul>

      <div class="site-header__tools">
        <a class="site-header__search" href="/en/games/">Search</a>

        <button class="site-header__language" type="button">
          EN
        </button>

     <label class="switch" aria-label="Theme switch">
  <input class="switch__input" type="checkbox" role="switch" data-theme-toggle>
  
  <svg class="switch__icon switch__icon--light" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
    <g fill="none" stroke="#fff" stroke-width="1" stroke-linecap="round">
      <circle cx="6" cy="6" r="2" />
      <g stroke-dasharray="1.5 1.5">
        <polyline points="6 10,6 11.5" transform="rotate(0,6,6)" />
        <polyline points="6 10,6 11.5" transform="rotate(45,6,6)" />
        <polyline points="6 10,6 11.5" transform="rotate(90,6,6)" />
        <polyline points="6 10,6 11.5" transform="rotate(135,6,6)" />
        <polyline points="6 10,6 11.5" transform="rotate(180,6,6)" />
        <polyline points="6 10,6 11.5" transform="rotate(225,6,6)" />
        <polyline points="6 10,6 11.5" transform="rotate(270,6,6)" />
        <polyline points="6 10,6 11.5" transform="rotate(315,6,6)" />
      </g>
    </g>
  </svg>

  <svg class="switch__icon switch__icon--dark" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
    <g fill="none" stroke="#fff" stroke-width="1" stroke-linejoin="round" transform="rotate(-45,6,6)">
      <path d="m9,10c-2.209,0-4-1.791-4-4s1.791-4,4-4c.304,0,.598.041.883.105-.995-.992-2.367-1.605-3.883-1.605C2.962.5.5,2.962.5,6s2.462,5.5,5.5,5.5c1.516,0,2.888-.613,3.883-1.605-.285.064-.578.105-.883.105Z"/>
    </g>
  </svg>

  <span class="switch__sr">Dark Mode</span>
</label>

        <a class="site-header__cta" href="/en/casinos/">Top casinos</a>
      </div>
    </nav>
  </div>
</header>

<script src="/assets/js/components/site-header.js" defer></script>
<script src="/assets/js/components/theme-toggle.js" defer></script>