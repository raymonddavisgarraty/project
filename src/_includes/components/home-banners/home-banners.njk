<section class="home-banners" aria-label="Featured promotions">
  <div class="container home-banners__grid">
    <div class="home-banners__slider" data-banner-slider>
      <div class="home-banners__track" data-banner-track>
        {% for slide in homeBanners.slides %}
          <a
            class="home-banners__slide"
            href="{{ slide.url }}"
            data-banner-slide
            {% if not loop.first %}hidden{% endif %}
          >
            {% if slide.image %}
              <img
                class="home-banners__image"
                src="{{ slide.image }}"
                alt="{{ slide.alt }}"
                width="1000"
                height="560"
                {% if loop.first %}loading="eager"{% else %}loading="lazy"{% endif %}
              >
            {% endif %}

            <span class="home-banners__shade"></span>

            <span class="home-banners__content">
              <span class="home-banners__label">{{ slide.label }}</span>

              <span class="home-banners__title">{{ slide.title }}</span>

              <span class="home-banners__text">{{ slide.text }}</span>

              <span class="home-banners__meta">
                <span class="home-banners__rating">★ 4.8 editorial rating</span>
                <span>{{ slide.note }}</span>
              </span>

              <span class="home-banners__cta">{{ slide.cta }}</span>
            </span>
          </a>
        {% endfor %}
      </div>

      <div class="home-banners__controls" aria-label="Banner controls">
  <div class="home-banners__dots" data-banner-dots>
    {% for slide in homeBanners.slides %}
      <button
        class="home-banners__dot{% if loop.first %} home-banners__dot--active{% endif %}"
        type="button"
        data-banner-dot="{{ loop.index0 }}"
        aria-label="Show banner {{ loop.index }}"
        {% if loop.first %}aria-current="true"{% endif %}
      ></button>
    {% endfor %}
  </div>

  <div class="home-banners__arrows">
    <button class="home-banners__button home-banners__button--prev" type="button" data-banner-prev aria-label="Previous banner">
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path d="M10.2 13.1a.8.8 0 0 1-1.1 0L5.1 9.1a1.6 1.6 0 0 1 0-2.2l4-4a.8.8 0 1 1 1.1 1.1L6.2 8l4 4a.8.8 0 0 1 0 1.1Z"/>
      </svg>
    </button>

    <button class="home-banners__button home-banners__button--next" type="button" data-banner-next aria-label="Next banner">
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path d="M5.8 13.1a.8.8 0 0 0 1.1 0l4-4a1.6 1.6 0 0 0 0-2.2l-4-4A.8.8 0 1 0 5.8 4l4 4-4 4a.8.8 0 0 0 0 1.1Z"/>
      </svg>
    </button>
  </div>
</div>
    </div>

    <div class="home-banners__widgets">
      {% for widget in homeBanners.widgets %}
        <a class="home-banners__widget" href="{{ widget.url }}">
          {% if widget.image %}
            <img
              class="home-banners__widget-image"
              src="{{ widget.image }}"
              alt="{{ widget.alt }}"
              width="420"
              height="260"
              loading="lazy"
            >
          {% endif %}

          <span class="home-banners__widget-shade"></span>

          <span class="home-banners__widget-content">
            <span class="home-banners__widget-label">{{ widget.title }}</span>
            <span class="home-banners__widget-text">{{ widget.text }}</span>
            <span class="home-banners__widget-link">Open</span>
          </span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>