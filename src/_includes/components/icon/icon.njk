<span class="icon icon--{{ name }}" aria-hidden="true">
  {% if name == "check" %}
    <svg viewBox="0 0 16 16" focusable="false">
      <path d="M6.4 11.7 2.9 8.2l1.2-1.2 2.3 2.3 5.5-5.6 1.2 1.2-6.7 6.8Z"/>
    </svg>
  {% elif name == "shield" %}
    <svg viewBox="0 0 16 16" focusable="false">
      <path d="M8 1.2 13 3v3.9c0 3.2-2 6.1-5 7.2-3-1.1-5-4-5-7.2V3l5-1.8Zm0 1.7L4.5 4.1v2.8c0 2.3 1.3 4.5 3.5 5.5 2.2-1 3.5-3.2 3.5-5.5V4.1L8 2.9Z"/>
    </svg>
  {% elif name == "star" %}
    <svg viewBox="0 0 16 16" focusable="false">
      <path d="m8 1.4 1.9 4 4.4.6-3.2 3.1.8 4.4L8 11.4l-3.9 2.1.8-4.4L1.7 6l4.4-.6L8 1.4Z"/>
    </svg>
  {% elif name == "clock" %}
    <svg viewBox="0 0 16 16" focusable="false">
      <path d="M8 1.5A6.5 6.5 0 1 1 8 14.5 6.5 6.5 0 0 1 8 1.5Zm0 1.5A5 5 0 1 0 8 13 5 5 0 0 0 8 3Zm.7 2v3.1l2.2 1.3-.7 1.2-3-1.8V5h1.5Z"/>
    </svg>
  {% elif name == "bonus" %}
    <svg viewBox="0 0 16 16" focusable="false">
      <path d="M2 6h12v8H2V6Zm1.5 1.5v5h9v-5h-9ZM1.5 3.5h13V6h-13V3.5Zm6.5 0h1.5V14H8V3.5Zm-2.8-.3C4.5 2.5 4.9 1.5 6 1.5c1.1 0 1.8 1.1 2 2H6.4c-.5 0-.9-.1-1.2-.3Zm5.6 0c-.3.2-.7.3-1.2.3H8c.2-.9.9-2 2-2 1.1 0 1.5 1 .8 1.7Z"/>
    </svg>
  {% elif name == "cards" %}
    <svg viewBox="0 0 16 16" focusable="false">
      <path d="M2 4.5A2.5 2.5 0 0 1 4.5 2h7A2.5 2.5 0 0 1 14 4.5v7a2.5 2.5 0 0 1-2.5 2.5h-7A2.5 2.5 0 0 1 2 11.5v-7Zm2.5-1A1 1 0 0 0 3.5 4.5v7a1 1 0 0 0 1 1h7a1 1 0 0 0 1-1v-7a1 1 0 0 0-1-1h-7Zm1 2h5v1.5h-5V5.5Zm0 3h3v1.5h-3V8.5Z"/>
    </svg>
  {% else %}
    <svg viewBox="0 0 16 16" focusable="false">
      <circle cx="8" cy="8" r="6"/>
    </svg>
  {% endif %}
</span>